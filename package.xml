<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mocap4r2_interfaces</name>
  <version>2.0.0</version>
  <description>Messages and services of the MOCAP4ROS2 project: markers, rigid bodies, skeletons and system control</description>
  <maintainer email="fmrico@gmail.com">Francisco Martín Rico</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://mocap4ros2-project.github.io</url>
  <url type="repository">https://github.com/MOCAP4ROS2-Project/mocap4r2_interfaces</url>
  <url type="bugtracker">https://github.com/MOCAP4ROS2-Project/mocap4r2_interfaces/issues</url>
  <author email="fmrico@gmail.com">Francisco Martín Rico</author>
  <author>José Miguel Guerrero</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
